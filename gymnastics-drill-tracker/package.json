{
  "name": "gymnastics-drill-tracker",
  "productName": "Gymnastics Drill Tracker",
  "version": "1.0.0",
  "description": "App for managing and tracking gymnastics drills",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . --no-asar --ignore=data --out=builds --overwrite"
  },
  "author": "Aaron",
  "license": "MIT",
  "dependencies": {
    "electron": "^43.1.1"
  },
  "electronmon": {
    "patterns": [
      "!data/**"
    ]
  },
  "build": {
    "appId": "com.LumaDev.GymnasticsDrillTracker",
    "files": "!data"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0"
  }
}
